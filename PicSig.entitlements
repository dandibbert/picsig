<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "Use Installed Fonts": without it iOS 14+ hides fonts the user installed
	     through configuration profiles or font apps from this process and from
	     the system font picker it presents. -->
	<key>com.apple.developer.user-fonts</key>
	<array>
		<string>app-usage</string>
	</array>
</dict>
</plist>
